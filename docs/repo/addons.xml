<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="script.arr.bridge" name="Arr Bridge" version="0.1.2" provider-name="Arr Bridge">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="plugin.video.themoviedb.helper" version="5.0.0" optional="true" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="kodi.context.item">
      <menu id="kodi.core.main">
        <item library="context.py">
          <label>Add to Radarr / Sonarr</label>
          <visible>String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,episode) | !String.IsEmpty(ListItem.TVShowTitle) | String.Contains(ListItem.FolderPath,plugin.video.themoviedb.helper) | !String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.Property(tmdb_id))</visible>
        </item>
      </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Send selected movies and series to Radarr and Sonarr.</summary>
      <description lang="en_GB">Search with TMDb Helper, then choose a server quality profile, root folder, monitoring and search options in a remote-friendly dialog. Supports context menus and explicit skin or keymap actions.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
  <addon id="repository.arr.bridge" name="Arr Bridge Repository" version="1.0.0" provider-name="WodKa78">
    <extension point="xbmc.addon.repository" name="Arr Bridge Repository">
      <dir>
        <info>https://raw.githubusercontent.com/WodKa78/kodi-arr-bridge/main/docs/repo/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/WodKa78/kodi-arr-bridge/main/docs/repo/addons.xml.md5</checksum>
        <datadir>https://raw.githubusercontent.com/WodKa78/kodi-arr-bridge/main/docs/repo/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Updates for Arr Bridge.</summary>
      <description lang="en_GB">Install Arr Bridge and receive future published updates from WodKa78. Adds selected movies and TV series to Radarr and Sonarr.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
  <addon id="script.arr.remove" name="Arr Remove" version="0.1.1" provider-name="Arr Bridge">
    <requires>
      <import addon="xbmc.python" version="3.0.1"/>
      <import addon="script.arr.bridge" version="0.1.2"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py"><provides>executable</provides></extension>
    <extension point="kodi.context.item">
      <menu id="kodi.core.main">
        <item library="context.py">
          <label>Remove from Kodi / Arr</label>
          <visible>String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)</visible>
        </item>
      </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Remove library movies and shows, optionally also from Radarr or Sonarr.</summary>
      <description lang="en_GB">Adds a context-menu removal action for Kodi library movies and TV shows. It can remove the Kodi library entry only, or additionally remove the matching Arr entry, its files, and import-list exclusion.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
</addons>
